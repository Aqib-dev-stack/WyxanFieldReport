<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP, in release builds too, so the app can reach the demo
  backend on this network (API_URL=http://<Mac IP>:4000). React Native's
  Gradle plugin forces usesCleartextTraffic=false for release; Android ignores
  that attribute when a network security config like this one exists.

  Production: serve the API over HTTPS and delete this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
