{
  "name": "wyxan-field-report-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small API the Wyxan Field Report app uploads to. Express + MongoDB, images on disk.",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test 'test/**/*.test.ts'",
