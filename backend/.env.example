# Copy to .env and fill in. .env is git-ignored; never put real credentials here.
# Local MongoDB, or a MongoDB Atlas string: mongodb+srv://<user>:<password>@<cluster>/wyxan
PORT=4000
MONGODB_URI=mongodb://localhost:27017/wyxan
UPLOAD_DIR=./uploads
# Chaos and reset endpoints, for testing failure handling. Never enable in production.
ENABLE_ADMIN=true
# How long the "slow" chaos mode waits before handling a request (ms).
SLOW_DELAY_MS=8000
